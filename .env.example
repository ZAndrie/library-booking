# ==========================================
# Library Booking System - Environment Config
# ==========================================

# MongoDB Connection String (MongoDB Atlas or self-hosted)
# In production on Vercel, paste your cloud connection string here:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/library-booking?retryWrites=true&w=majority

# JWT Authentication Secret Key (Generate any secure random string)
JWT_SECRET=production_super_secret_jwt_library_key_2026

# Node Environment
NODE_ENV=production
